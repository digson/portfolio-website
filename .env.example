# Copy this file to .env.local for local development, and add the same
# variables in Vercel (Project > Settings > Environment Variables) for production.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=ochanwoo0615@gmail.com

# Optional: sender on a domain verified in Resend (e.g. contact@chanwoooh.com).
# Leave empty to use Resend's test sender, which only delivers to your Resend account email.
CONTACT_FROM_EMAIL=
